{
  "name": "dzen-bookings-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dzen-bookings",
    "db:migrate:local": "wrangler d1 migrations apply dzen-bookings --local",
    "db:migrate:remote": "wrangler d1 migrations apply dzen-bookings --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
